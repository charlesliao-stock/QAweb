rules_version = '2';
// 護理品質指標管理系統 — Firestore Security Rules（第一階段：Spark 方案 v1.3）
// 權限以 users/{職編} 文件的 roles 欄位判斷（第二階段改 custom claims）。
// 登入 email 格式為 {職編}@nurseboard.internal，規則從 token email 取職編。
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // 從登入 token 的 email 取職編（admin@nurseboard.internal → admin）
    function staffId() {
      return isAuthed() && request.auth.token.email is string
        ? request.auth.token.email.split('@')[0]
        : '';
    }

    // 登入者自己的人員文件 roles（第二階段改 claims 後此函式可刪）
    function myRoles() {
      return get(/databases/$(database)/documents/users/$(staffId())).data.get('roles', []);
    }

    function hasRole(r) {
      return isAuthed() && r in myRoles();
    }

    function isAdmin() {
      return hasRole('系統管理員');
    }

    // 新版週期排程每一個 N 名額對應一個固定 reviewRecords 文件 ID。
    // 同一名額競態提交時，第二次寫入會變成 update；version guard 會拒絕舊版覆寫。
    function validQuotaSlot(id) {
      let groupId = request.resource.data.get('quotaGroupId', '');
      let group = get(/databases/$(database)/documents/reviewQuotaGroups/$(groupId));
      return groupId is string
        && exists(/databases/$(database)/documents/reviewQuotaGroups/$(groupId))
        && request.resource.data.get('quotaSlotDocId', '') == id
        && id in group.data.get('slotIds', []);
    }

    // 任務建立後，指標版本／閾值／審查區間為摘要依據，不得隨一般任務狀態更新而改寫。
    function preservesTaskSnapshot() {
      return request.resource.data.get('indicatorId', null) == resource.data.get('indicatorId', null)
        && request.resource.data.get('year', null) == resource.data.get('year', null)
        && request.resource.data.get('month', null) == resource.data.get('month', null)
        && request.resource.data.get('unitId', null) == resource.data.get('unitId', null)
        && request.resource.data.get('indicatorVersionAtSchedule', null) == resource.data.get('indicatorVersionAtSchedule', null)
        && request.resource.data.get('thresholdAtSchedule', null) == resource.data.get('thresholdAtSchedule', null)
        && request.resource.data.get('thresholdRuleAtSchedule', null) == resource.data.get('thresholdRuleAtSchedule', null)
        && request.resource.data.get('scheduleStartYear', null) == resource.data.get('scheduleStartYear', null)
        && request.resource.data.get('scheduleStartMonth', null) == resource.data.get('scheduleStartMonth', null)
        && request.resource.data.get('scheduleEndYear', null) == resource.data.get('scheduleEndYear', null)
        && request.resource.data.get('scheduleEndMonth', null) == resource.data.get('scheduleEndMonth', null);
    }

    // 原始審查內容可依核准流程修正，但指標／任務／閾值／區間快照不可變。
    function preservesReviewSnapshot() {
      return request.resource.data.get('indicatorId', null) == resource.data.get('indicatorId', null)
        && request.resource.data.get('year', null) == resource.data.get('year', null)
        && request.resource.data.get('month', null) == resource.data.get('month', null)
        && request.resource.data.get('unitId', null) == resource.data.get('unitId', null)
        && request.resource.data.get('indicatorVersionAtSchedule', null) == resource.data.get('indicatorVersionAtSchedule', null)
        && request.resource.data.get('thresholdAtSchedule', null) == resource.data.get('thresholdAtSchedule', null)
        && request.resource.data.get('thresholdRuleAtSchedule', null) == resource.data.get('thresholdRuleAtSchedule', null)
        && request.resource.data.get('scheduleStartYear', null) == resource.data.get('scheduleStartYear', null)
        && request.resource.data.get('scheduleStartMonth', null) == resource.data.get('scheduleStartMonth', null)
        && request.resource.data.get('scheduleEndYear', null) == resource.data.get('scheduleEndYear', null)
        && request.resource.data.get('scheduleEndMonth', null) == resource.data.get('scheduleEndMonth', null);
    }

    function isGanShi() {
      return hasRole('品管執行幹事') || isAdmin();
    }

    function canManageSchedule() {
      return hasRole('召集人')
        || hasRole('品管組召集人')
        || hasRole('執行幹事')
        || hasRole('品管組執行幹事')
        || isAdmin();
    }

    // 人員主檔：本人可讀寫自己（不可改 roles/status）；管理員全權
    // 幹事可查人員清單（建指標選負責人用），但不可新增/刪除
    match /users/{id} {
      allow get: if isAuthed() && (id == staffId() || isAdmin());
      allow list: if isAdmin() || isGanShi();
      allow create: if isAdmin();
      allow update: if isAuthed() && (isAdmin() || (id == staffId()
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('status', '') == resource.data.get('status', '')));
      allow delete: if isAdmin();
    }

    // 預計算品質摘要：登入者唯讀，僅 Admin SDK 後端可寫。
    match /reviewSummaries/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 持久化通知：僅文件所屬使用者可讀取／標記已讀；不得由用戶端建立或刪除。
    match /notifications/{id} {
      allow get, list: if isAuthed() && resource.data.get('userId', '') == staffId();
      allow update: if isAuthed()
        && resource.data.get('userId', '') == staffId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.get('read', false) is bool;
      allow create, delete: if false;
    }

    // 系統參數：登入可讀，管理員可寫
    match /systemParams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // UI 主題定義（v1.32.0，資料驅動）：登入可讀，管理員可寫（與 systemParams 同級，無擴權）
    match /uiThemes/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    // 稽核軌跡：僅允許新增（append-only），查詢限管理員
    match /auditLogs/{id} {
      allow get, list: if isAdmin();
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // 主檔與設定類：登入可讀，幹事以上可寫
    match /units/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /groups/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /titles/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /roles/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
    match /indicators/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicators/{id}/versions/{vid} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /guidelineDocs/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }

    // 指標排程（v1.8.0）：主檔與設定類登入可讀、幹事以上可寫
    match /reviewReviewers/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicatorYearSchedules/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    // 指標排程（v1.16.0）：三類別（年度／學年度／臨時）；同等嚴格度
    match /indicatorSchedules/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicatorAssignments/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }

    // 指標排程（v1.8.0）：審查任務為業務資料，第一階段登入者可讀寫
    match /reviewTasks/{id} {
      allow read, create, delete: if isAuthed();
      allow update: if isAuthed() && preservesTaskSnapshot();
    }

    // 週期排程共用配額名額清單：不含個人審查資料，排程幹事以上維護。
    match /reviewQuotaGroups/{id} {
      allow read: if isAuthed();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }

    // 審查執行紀錄（v1.10.0）：業務資料，第一階段登入者可讀寫
    match /reviewRecords/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && (!('quotaGroupId' in request.resource.data) || validQuotaSlot(id));
      allow update: if isAuthed() && preservesReviewSnapshot() && (
        (!('quotaGroupId' in resource.data)
          && !('quotaGroupId' in request.resource.data))
        || ('quotaGroupId' in resource.data
          && request.resource.data.get('quotaGroupId', '') == resource.data.quotaGroupId
          && request.resource.data.get('quotaSlotDocId', '') == id
          && resource.data.get('quotaSlotDocId', '') == id
          && request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1)
      );
      allow delete: if isAdmin();
    }

    // 解鎖申請（v1.15.0）：登入者可讀；申請人（requestedBy＝本人職編）可建立；
    // 執行幹事以上可審核更新；刪除限管理員
    match /unlockRequests/{id} {
      allow get, list: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.get('requestedBy', '') == staffId()
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isGanShi();
      allow delete: if isAdmin();
    }

    // 業務資料：第一階段登入者可讀寫（第二階段按單位/角色收緊）
    match /schedules/{id} {
      allow read, write: if isAuthed();
    }
    match /reviews/{id} {
      allow read, write: if isAuthed();
    }
    match /capa/{id} {
      allow read, write: if isAuthed();
    }
    match /reportTemplates/{id} {
      allow read, write: if isAuthed();
    }
  }
}

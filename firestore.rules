rules_version = '2';
// 護理品質指標管理系統 — Firestore Security Rules（第一階段：Spark 方案 v1.3）
// 權限以 users/{職編} 文件的 roles 欄位判斷（第二階段改 custom claims）。
// 登入 email 格式為 {職編}@kmuh.org.tw，規則從 token email 取職編。
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // 從登入 token 的 email 取職編（admin@kmuh.org.tw → admin）
    // v1.84.1：信箱去掉了職編開頭的 0，所以優先讀自訂標記 staffId（建立帳號時寫入）；
    // 沒有標記的帳號（例如手動建立的 admin）退回信箱 @ 前面的部分。
    function staffId() {
      return isAuthed()
        ? (request.auth.token.get('staffId', '') is string && request.auth.token.get('staffId', '') != ''
            ? request.auth.token.get('staffId', '')
            : (request.auth.token.email is string ? request.auth.token.email.split('@')[0] : ''))
        : '';
    }

    // 登入者自己的人員文件 roles（第二階段改 claims 後此函式可刪）
    function myRoles() {
      return get(/databases/$(database)/documents/users/$(staffId())).data.get('roles', []);
    }

    function hasRole(r) {
      return isAuthed() && r in myRoles();
    }

    // 登入者所屬單位（護理長讀取本單位人員以指派 CAPA 撰寫人）
    function myUnitCode() {
      return get(/databases/$(database)/documents/users/$(staffId())).data.get('unitCode', '');
    }

    function isUnitHeadOf(data) {
      return hasRole('護理長') && myUnitCode() != '' && data.get('unitCode', '') == myUnitCode();
    }

    // 督導以 titleUnitCodes 管轄多個單位：可讀其管轄單位的編制人員（指派 CAPA 撰寫人）
    function myTitleUnitCodes() {
      return get(/databases/$(database)/documents/users/$(staffId())).data.get('titleUnitCodes', []);
    }

    function isSupervisorOf(data) {
      return hasRole('督導') && data.get('unitCode', '') in myTitleUnitCodes();
    }

    function isAdmin() {
      return hasRole('系統管理員');
    }

    // 新版週期排程每一個 N 名額對應一個固定 reviewRecords 文件 ID。
    // 同一名額競態提交時，第二次寫入會變成 update；version guard 會拒絕舊版覆寫。
    function validQuotaSlot(id) {
      let groupId = request.resource.data.get('quotaGroupId', '');
      let group = get(/databases/$(database)/documents/reviewQuotaGroups/$(groupId));
      return groupId is string
        && exists(/databases/$(database)/documents/reviewQuotaGroups/$(groupId))
        && request.resource.data.get('quotaSlotDocId', '') == id
        && id in group.data.get('slotIds', []);
    }

    function reservationTargetMatches(id, data) {
      let targetId = data.get('targetId', '');
      let targetCollection = data.get('targetCollection', '');
      let draftPath = /databases/$(database)/documents/reviewDrafts/$(targetId);
      let recordPath = /databases/$(database)/documents/reviewRecords/$(targetId);
      return (targetCollection == 'reviewDrafts'
          && existsAfter(draftPath)
          && getAfter(draftPath).data.get('uniqueKey', '') == id)
        || (targetCollection == 'reviewRecords'
          && existsAfter(recordPath)
          && getAfter(recordPath).data.get('uniqueKey', '') == id);
    }

    function recordHasReservation(id, data) {
      let uniqueKey = data.get('uniqueKey', '');
      let lockPath = /databases/$(database)/documents/reviewReservations/$(uniqueKey);
      return uniqueKey == '' || (uniqueKey is string
        && existsAfter(lockPath)
        && getAfter(lockPath).data.get('targetCollection', '') == 'reviewRecords'
        && getAfter(lockPath).data.get('targetId', '') == id);
    }

    function draftHasReservation(id, data) {
      let uniqueKey = data.get('uniqueKey', '');
      let lockPath = /databases/$(database)/documents/reviewReservations/$(uniqueKey);
      return uniqueKey == '' || (uniqueKey is string
        && existsAfter(lockPath)
        && getAfter(lockPath).data.get('targetCollection', '') == 'reviewDrafts'
        && getAfter(lockPath).data.get('targetId', '') == id);
    }

    // 任務建立後，指標版本／閾值／審查區間為摘要依據，不得隨一般任務狀態更新而改寫。
    function preservesTaskSnapshot() {
      return request.resource.data.get('indicatorId', null) == resource.data.get('indicatorId', null)
        && request.resource.data.get('year', null) == resource.data.get('year', null)
        && request.resource.data.get('month', null) == resource.data.get('month', null)
        && request.resource.data.get('unitId', null) == resource.data.get('unitId', null)
        && request.resource.data.get('indicatorVersionAtSchedule', null) == resource.data.get('indicatorVersionAtSchedule', null)
        && request.resource.data.get('thresholdAtSchedule', null) == resource.data.get('thresholdAtSchedule', null)
        && request.resource.data.get('thresholdRuleAtSchedule', null) == resource.data.get('thresholdRuleAtSchedule', null)
        && request.resource.data.get('scheduleStartYear', null) == resource.data.get('scheduleStartYear', null)
        && request.resource.data.get('scheduleStartMonth', null) == resource.data.get('scheduleStartMonth', null)
        && request.resource.data.get('scheduleEndYear', null) == resource.data.get('scheduleEndYear', null)
        && request.resource.data.get('scheduleEndMonth', null) == resource.data.get('scheduleEndMonth', null);
    }

    // 原始審查內容可依核准流程修正，但指標／任務／閾值／區間快照不可變。
    function preservesReviewSnapshot() {
      return request.resource.data.get('indicatorId', null) == resource.data.get('indicatorId', null)
        && request.resource.data.get('year', null) == resource.data.get('year', null)
        && request.resource.data.get('month', null) == resource.data.get('month', null)
        && request.resource.data.get('unitId', null) == resource.data.get('unitId', null)
        && request.resource.data.get('indicatorVersionAtSchedule', null) == resource.data.get('indicatorVersionAtSchedule', null)
        && request.resource.data.get('thresholdAtSchedule', null) == resource.data.get('thresholdAtSchedule', null)
        && request.resource.data.get('thresholdRuleAtSchedule', null) == resource.data.get('thresholdRuleAtSchedule', null)
        && request.resource.data.get('scheduleStartYear', null) == resource.data.get('scheduleStartYear', null)
        && request.resource.data.get('scheduleStartMonth', null) == resource.data.get('scheduleStartMonth', null)
        && request.resource.data.get('scheduleEndYear', null) == resource.data.get('scheduleEndYear', null)
        && request.resource.data.get('scheduleEndMonth', null) == resource.data.get('scheduleEndMonth', null);
    }

    function isGanShi() {
      return hasRole('品管組執行幹事') || isAdmin();
    }

    function canManageSchedule() {
      return hasRole('召集人')
        || hasRole('品管組召集人')
        || hasRole('執行幹事')
        || hasRole('品管組執行幹事')
        || isAdmin();
    }

    // 只有全院主管／品管幹事可跨所有單位讀取審查資料；一般排程管理者
    // 仍依任務所屬單位或本人任務範圍存取，不能藉管理排程取得全院個資。
    function canReadAllReviews() {
      return isAdmin() || isGanShi()
        || hasRole('主任') || hasRole('副主任')
        || hasRole('護理部主管') || hasRole('督導長');
    }

    function inReviewUnit(data) {
      let unit = data.get('unitId', data.get('unitCode', ''));
      return unit is string && unit != ''
        && ((hasRole('護理長') && unit == myUnitCode())
          || (hasRole('督導') && unit in myTitleUnitCodes()));
    }

    function canReadReviewRecord(data) {
      return canReadAllReviews()
        || data.get('reviewerId', '') == staffId()
        || data.get('reviewedPersonEmpNo', '') == staffId()
        || inReviewUnit(data);
    }

    function canReadReviewTask(data) {
      return canReadAllReviews()
        || canManageSchedule()
        || data.get('reviewerId', '') == staffId()
        || inReviewUnit(data);
    }

    function canReadCapa(data) {
      return canReadAllReviews() || canManageSchedule() || hasRole('督導')
        || data.get('ownerId', '') == staffId()
        || data.get('writerId', data.get('ownerId', '')) == staffId()
        || inReviewUnit(data);
    }

    // ---------- P0（v1.85.5）：寫入濫用收緊 ----------
    // 規則語言沒有速率限制原語；此處能做的是「誰能寫」＋「寫什麼欄位」＋
    // 「欄位多大」。單筆文件上限仍是平台 1 MiB；巢狀內容（answers／
    // editHistory／before／after 內層）規則無法逐項量測，僅限件數，見各集合註解。
    function strOk(v, m) {
      return v is string && v.size() <= m;
    }
    function optStr(data, key, m) {
      return !(key in data) || strOk(data.get(key, ''), m);
    }
    function optNum(data, key) {
      return !(key in data) || data.get(key, null) is number;
    }
    function optTs(data, key) {
      return !(key in data) || data.get(key, null) is timestamp;
    }

    // reviewTasks 欄位白名單（建立時整份文件；更新時以異動鍵比對，見下）
    function taskKeysValid(data) {
      return data.keys().hasOnly([
          'indicatorId', 'year', 'month', 'unitId', 'reviewerId', 'caseCount',
          'deadline', 'status', 'quotaVersion', 'quotaGroupId', 'quotaCategory',
          'quotaIntervalStartYear', 'quotaIntervalStartMonth',
          'quotaIntervalEndYear', 'quotaIntervalEndMonth',
          'scheduleCategory', 'schedulePeriod',
          'indicatorVersionAtSchedule', 'thresholdAtSchedule', 'thresholdRuleAtSchedule',
          'scheduleStartYear', 'scheduleStartMonth', 'scheduleEndYear', 'scheduleEndMonth',
          'createdAt', 'completedAt', 'assignmentStatus', 'reassignedAt', 'reassignedBy'])
        && strOk(data.get('indicatorId', ''), 128)
        && strOk(data.get('unitId', ''), 128)
        && strOk(data.get('reviewerId', ''), 32)
        && optStr(data, 'deadline', 32)
        && optStr(data, 'status', 32)
        && optStr(data, 'assignmentStatus', 32)
        && optStr(data, 'reassignedBy', 32)
        && optStr(data, 'scheduleCategory', 32)
        && optStr(data, 'schedulePeriod', 64)
        && optStr(data, 'quotaGroupId', 256)
        && optStr(data, 'quotaCategory', 32)
        && optStr(data, 'thresholdRuleAtSchedule', 8)
        && optStr(data, 'indicatorVersionAtSchedule', 64)
        && optNum(data, 'year') && optNum(data, 'month')
        && optNum(data, 'thresholdAtSchedule')
        && optNum(data, 'quotaIntervalStartYear') && optNum(data, 'quotaIntervalStartMonth')
        && optNum(data, 'quotaIntervalEndYear') && optNum(data, 'quotaIntervalEndMonth')
        && optNum(data, 'scheduleStartYear') && optNum(data, 'scheduleStartMonth')
        && optNum(data, 'scheduleEndYear') && optNum(data, 'scheduleEndMonth')
        && optNum(data, 'quotaVersion')
        && (data.get('caseCount', null) == null || data.get('caseCount', null) is number)
        && optTs(data, 'createdAt') && optTs(data, 'completedAt') && optTs(data, 'reassignedAt');
    }
    // reviewTasks 更新只許動這幾個鍵（舊文件若帶有白名單外欄位，更新不受影響）
    function taskUpdateKeysValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'completedAt', 'reviewerId', 'assignmentStatus',
        'reassignedAt', 'reassignedBy']);
    }
    function taskUpdateValuesValid() {
      let d = request.resource.data;
      return optStr(d, 'status', 32) && optStr(d, 'assignmentStatus', 32)
        && optStr(d, 'reviewerId', 32) && optStr(d, 'reassignedBy', 32)
        && optTs(d, 'completedAt') && optTs(d, 'reassignedAt');
    }
    // 週期共用配額同步（ReviewExecutePage syncPeriodicQuotaTaskStatus）：
    // 同配額組的任務由不同審查員持有，提交者須同步整組任務狀態；
    // 規則看不到「呼叫者的任務」，故僅限「只改 status／completedAt」的更新，
    // 且新狀態只能是 done／pending。殘留風險：任一登入者可翻動配額任務的
    // 狀態顯示；審查紀錄本身仍以 reviewRecords 為準，不受影響。
    function quotaTaskStatusSync() {
      return resource.data.get('quotaGroupId', '') is string
        && resource.data.get('quotaGroupId', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
        && request.resource.data.get('status', '') in ['done', 'pending']
        && (request.resource.data.get('completedAt', null) == null
          || request.resource.data.get('completedAt', null) is timestamp);
    }

    // reviewRecords 欄位白名單（建立時整份文件；更新時以異動鍵比對，見下）
    function recordKeysValid(data) {
      return data.keys().hasOnly([
          'taskId', 'indicatorId', 'unitId', 'reviewerId', 'year', 'month',
          'indicatorVersionAtSchedule', 'thresholdAtSchedule', 'thresholdRuleAtSchedule',
          'scheduleStartYear', 'scheduleStartMonth', 'scheduleEndYear', 'scheduleEndMonth',
          'caseSeq', 'reviewDate', 'reviewerEmpNo', 'reviewerName',
          'reviewedPersonEmpNo', 'reviewedPersonName', 'uniqueKey', 'bedNo', 'auditItem',
          'answers', 'totalScore', 'maxScore', 'rate', 'submittedAt', 'submittedBy',
          'quotaGroupId', 'quotaCaseNo', 'quotaSlotDocId', 'version',
          'editHistory', 'lastModifiedAt', 'lastModifiedBy', 'lastModifiedByName'])
        && strOk(data.get('taskId', ''), 128)
        && strOk(data.get('indicatorId', ''), 128)
        && strOk(data.get('unitId', ''), 128)
        && strOk(data.get('reviewerId', ''), 32)
        && optStr(data, 'reviewDate', 32)
        && optStr(data, 'reviewerEmpNo', 32)
        && optStr(data, 'reviewerName', 50)
        && optStr(data, 'reviewedPersonEmpNo', 32)
        && optStr(data, 'reviewedPersonName', 50)
        && optStr(data, 'uniqueKey', 200)
        && optStr(data, 'bedNo', 32)
        && optStr(data, 'auditItem', 200)
        && optStr(data, 'thresholdRuleAtSchedule', 8)
        && optStr(data, 'indicatorVersionAtSchedule', 64)
        && optStr(data, 'quotaGroupId', 256)
        && optStr(data, 'quotaSlotDocId', 256)
        && optStr(data, 'submittedBy', 32)
        && optStr(data, 'lastModifiedBy', 32)
        && optStr(data, 'lastModifiedByName', 50)
        && optNum(data, 'year') && optNum(data, 'month')
        && optNum(data, 'caseSeq') && optNum(data, 'totalScore')
        && optNum(data, 'maxScore') && optNum(data, 'rate')
        && optNum(data, 'thresholdAtSchedule')
        && optNum(data, 'quotaCaseNo') && optNum(data, 'version')
        && optNum(data, 'scheduleStartYear') && optNum(data, 'scheduleStartMonth')
        && optNum(data, 'scheduleEndYear') && optNum(data, 'scheduleEndMonth')
        && optTs(data, 'submittedAt') && optTs(data, 'lastModifiedAt')
        && (!('answers' in data) || (data.get('answers', []) is list && data.get('answers', []).size() <= 100))
        && (!('editHistory' in data) || (data.get('editHistory', []) is list && data.get('editHistory', []).size() <= 100));
    }
    // reviewRecords 更新只許動這幾個鍵
    function recordUpdateKeysValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers', 'totalScore', 'maxScore', 'rate', 'reviewDate',
        'reviewerEmpNo', 'reviewerName', 'reviewedPersonEmpNo', 'reviewedPersonName',
        'uniqueKey', 'bedNo', 'auditItem',
        'indicatorVersionAtSchedule', 'thresholdAtSchedule',
        'scheduleStartYear', 'scheduleStartMonth', 'scheduleEndYear', 'scheduleEndMonth',
        'version', 'editHistory', 'lastModifiedAt', 'lastModifiedBy', 'lastModifiedByName']);
    }
    function recordUpdateValuesValid() {
      let d = request.resource.data;
      return optStr(d, 'reviewDate', 32)
        && optStr(d, 'reviewerEmpNo', 32) && optStr(d, 'reviewerName', 50)
        && optStr(d, 'reviewedPersonEmpNo', 32) && optStr(d, 'reviewedPersonName', 50)
        && optStr(d, 'uniqueKey', 200) && optStr(d, 'bedNo', 32)
        && optStr(d, 'auditItem', 200)
        && optStr(d, 'thresholdRuleAtSchedule', 8)
        && optStr(d, 'indicatorVersionAtSchedule', 64)
        && optStr(d, 'lastModifiedBy', 32) && optStr(d, 'lastModifiedByName', 50)
        && optNum(d, 'totalScore') && optNum(d, 'maxScore') && optNum(d, 'rate')
        && optNum(d, 'thresholdAtSchedule')
        && optNum(d, 'version')
        && optTs(d, 'lastModifiedAt')
        && (!('answers' in d) || (d.get('answers', []) is list && d.get('answers', []).size() <= 100))
        && (!('editHistory' in d) || (d.get('editHistory', []) is list && d.get('editHistory', []).size() <= 100));
    }
    // 配額名額文件 ID 形如 {quotaGroupId}__slot__{n}；佔用這種 ID 的紀錄
    // 必須帶有效的 quotaGroupId，否則就是不帶配額欄位搶佔名額。
    function isQuotaSlotId(id) {
      return id.matches('.*__slot__.*');
    }

    // auditLogs 欄位白名單（28 處寫入點的鍵聯集；before／after／criteria
    // 為對照快照 map，僅限鍵數；內層巢狀內容規則無法逐項量測）
    function auditLogValid(data) {
      return data.keys().hasOnly([
          'actor', 'actorName', 'action', 'targetType', 'targetId', 'detail',
          'createdAt', 'before', 'after', 'criteria', 'documentIds', 'count'])
        && strOk(data.get('actor', ''), 32)
        && optStr(data, 'actorName', 50)
        && optStr(data, 'action', 100)
        && optStr(data, 'targetType', 50)
        && optStr(data, 'targetId', 500)
        && optStr(data, 'detail', 10000)
        && data.get('createdAt', null) is timestamp
        && data.get('createdAt', null) <= request.time
        && (!('before' in data) || (data.get('before', {}) is map && data.get('before', {}).keys().size() <= 100))
        && (!('after' in data) || (data.get('after', {}) is map && data.get('after', {}).keys().size() <= 100))
        && (!('criteria' in data) || (data.get('criteria', {}) is map && data.get('criteria', {}).keys().size() <= 50))
        && (!('documentIds' in data) || (data.get('documentIds', []) is list && data.get('documentIds', []).size() <= 500))
        && (!('count' in data) || data.get('count', null) is number);
    }

    // 人員主檔：本人可讀寫自己（不可改 roles/status）；管理員全權
    // 幹事可查人員清單（建指標選負責人用），但不可新增/刪除
    match /users/{id} {
      allow get: if isAuthed() && (id == staffId() || isAdmin() || isUnitHeadOf(resource.data) || isSupervisorOf(resource.data));
      allow list: if isAdmin() || isGanShi() || isUnitHeadOf(resource.data) || isSupervisorOf(resource.data);
      allow create: if isAdmin();
      allow update: if isAuthed() && (isAdmin() || (id == staffId()
        && request.resource.data.get('roles', []) == resource.data.get('roles', [])
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        // v1.85.5：本人亦不得改職稱／單位／分工表（異動只許管理員改，避免
        // 透過改 title 改變前端權限顯示、污染人員主檔與單位統計）
        && request.resource.data.get('title', null) == resource.data.get('title', null)
        && request.resource.data.get('titleId', null) == resource.data.get('titleId', null)
        && request.resource.data.get('unitCode', null) == resource.data.get('unitCode', null)
        && request.resource.data.get('memberships', null) == resource.data.get('memberships', null)));
      allow delete: if isAdmin();
    }

    // 開通信寄送記錄（v1.84.0，前端回報、僅供參考）：寄信時尚未登入，所以允許未登入建立，
    // 但只收固定欄位與長度、時間不得晚於伺服器時間（允許回填過去時間）；僅管理員可讀與刪除，不可修改。
    match /mailLogs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['staffId', 'result', 'source', 'at'])
        && request.resource.data.staffId is string
        && request.resource.data.staffId.size() > 0 && request.resource.data.staffId.size() <= 32
        && request.resource.data.result is string && request.resource.data.result.size() <= 40
        && request.resource.data.source == 'client'
        && request.resource.data.at is timestamp
        && request.resource.data.at <= request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 預計算品質摘要：登入者唯讀，僅 Admin SDK 後端可寫。
    match /reviewSummaries/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 持久化通知：僅文件所屬使用者可讀取／標記已讀；不得由用戶端建立或刪除。
    match /notifications/{id} {
      allow get, list: if isAuthed() && resource.data.get('userId', '') == staffId();
      allow update: if isAuthed()
        && resource.data.get('userId', '') == staffId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.get('read', false) is bool;
      allow create, delete: if false;
    }

    // 系統參數：登入可讀，管理員可寫
    match /systemParams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // 流量控管（v1.41.0）：configs/system_status（維護開關，監測 workflow 寫入）
    // 與 configs/quotaSettings（提醒／關站門檻、監測開關、LINE 開關，系統管理頁維護）。
    // 登入者可讀（前端攔截需讀取開關；Admin SDK 寫入繞過 rules），寫入限管理員。
    match /configs/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // UI 主題定義（v1.32.0，資料驅動）：登入可讀，管理員可寫（與 systemParams 同級，無擴權）
    match /uiThemes/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    // 稽核軌跡：僅允許新增（append-only），查詢限管理員。
    // v1.85.5：create 加欄位白名單＋字串長度上限＋createdAt 不得晚於伺服器時間
    // （雙寫複寫以固定毫秒值回填過去時間，須允許；仍擋未來時間造假），
    // 任一登入者仍可寫（稽核寫入點遍布各頁），但寫不進 1 MiB 假紀錄。
    match /auditLogs/{id} {
      allow get, list: if isAdmin();
      allow create: if isAuthed() && auditLogValid(request.resource.data);
      allow update, delete: if false;
    }

    // 主檔與設定類：登入可讀，幹事以上可寫
    match /units/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /groups/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /titles/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /roles/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
    // 層級（v1.55.0）：職稱層級寫入同 titles（幹事以上），角色層級寫入同 roles（管理員）
    match /titleLevels/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /roleLevels/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
    // 權限範本（v1.38.0 新增 permissionTemplates，v1.39.4 補規則）：
    // 登入可讀（can() 需為所有登入者載入範本判斷權限），寫入限管理員（與 roles 同級）。
    // 注意：此集合先前在 rules 完全沒有放行，伺服器讀取一律被拒，權限頁因此全空。
    match /permissionTemplates/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }
    match /indicators/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicators/{id}/versions/{vid} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /guidelineDocs/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }

    // 指標排程（v1.8.0）：主檔與設定類登入可讀、幹事以上可寫
    match /reviewReviewers/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicatorYearSchedules/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    // 指標排程（v1.16.0）：三類別（年度／學年度／臨時）；同等嚴格度
    match /indicatorSchedules/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }
    match /indicatorAssignments/{id} {
      allow read: if isAuthed();
      allow write: if isGanShi();
    }

    // 指標排程（v1.8.0）：審查任務。
    // v1.85.5：create 限排程管理者（幫審查員建任務）或本人（自審／自派）；
    // update 限本人或排程管理者＋快照不變，換審查員只許排程管理者；
    // delete 限管理員或排程管理者（排程產生／刪除排程時須清舊任務；
    // 任務無 createdBy 欄位，無法以建立者判斷）。週期配額整組狀態
    // 同步另見 quotaTaskStatusSync()。
    match /reviewTasks/{id} {
      allow read: if isAuthed() && canReadReviewTask(resource.data);
      allow create: if isAuthed()
        && (canManageSchedule() || request.resource.data.get('reviewerId', '') == staffId())
        && 'indicatorId' in request.resource.data
        && 'reviewerId' in request.resource.data
        && 'year' in request.resource.data
        && 'month' in request.resource.data
        && 'status' in request.resource.data
        && taskKeysValid(request.resource.data);
      allow update: if isAuthed() && (quotaTaskStatusSync()
        || ((resource.data.get('reviewerId', '') == staffId() || canManageSchedule())
          && preservesTaskSnapshot()
          && (request.resource.data.get('reviewerId', '') == resource.data.get('reviewerId', '')
            || canManageSchedule())
          && taskUpdateKeysValid()
          && taskUpdateValuesValid()));
      allow delete: if isAdmin() || canManageSchedule();
    }

    // 週期排程共用配額名額清單：不含個人審查資料，排程幹事以上維護。
    match /reviewQuotaGroups/{id} {
      allow read: if isAuthed();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }

    // 審查執行紀錄（v1.10.0）。
    // v1.85.5：create 限本人（reviewerId 與 submittedBy 皆須為本人）＋
    // 欄位白名單；uniqueKey 鍵不可省略（部分指標不需受審人員，值可為空字串，
    // 有值時須有預約鎖）；quotaGroupId 不可省略的邏輯改為「佔用配額名額
    // 文件 ID（__slot__）時必須帶有效 quotaGroupId」——非配額紀錄本來就
    // 沒有 quotaGroupId，全面強制會擋掉正常送出。update 限本人或排程管理者
    // （封存修改核准由執行幹事代為套用）＋快照不變＋異動鍵白名單。
    match /reviewRecords/{id} {
      allow read: if isAuthed() && canReadReviewRecord(resource.data);
      allow create: if isAuthed()
        && request.resource.data.get('reviewerId', '') == staffId()
        && request.resource.data.get('submittedBy', '') == staffId()
        && recordKeysValid(request.resource.data)
        && 'taskId' in request.resource.data
        && 'indicatorId' in request.resource.data
        && 'year' in request.resource.data
        && 'month' in request.resource.data
        && 'uniqueKey' in request.resource.data
        && request.resource.data.get('submittedAt', null) is timestamp
        && request.resource.data.get('submittedAt', null) <= request.time
        && (!('quotaGroupId' in request.resource.data) || validQuotaSlot(id))
        && (!isQuotaSlotId(id) || (('quotaGroupId' in request.resource.data) && validQuotaSlot(id)))
        && (request.resource.data.get('uniqueKey', '') == '' || recordHasReservation(id, request.resource.data));
      allow update: if isAuthed()
        && (resource.data.get('reviewerId', '') == staffId() || canManageSchedule())
        && preservesReviewSnapshot() && (
        (!('quotaGroupId' in resource.data)
          && !('quotaGroupId' in request.resource.data))
        || ('quotaGroupId' in resource.data
          && request.resource.data.get('quotaGroupId', '') == resource.data.quotaGroupId
          && request.resource.data.get('quotaSlotDocId', '') == id
          && resource.data.get('quotaSlotDocId', '') == id
          && request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1)
      ) && (!('uniqueKey' in request.resource.data) || recordHasReservation(id, request.resource.data))
        && recordUpdateKeysValid()
        && recordUpdateValuesValid();
      allow delete: if isAdmin();
    }

    // 已結束區間的封存摘要（v1.64.0；與舊的後端預計算 reviewSummaries 分開）：登入者可讀；召集人／執行幹事／管理員可建立與重算
    //（群組範圍由前端限制，Rules 僅驗證角色）；刪除限管理員。
    match /reviewArchives/{id} {
      // 封存摘要可能包含小樣本明細；沒有可驗證單位範圍時採管理角色限定。
      allow read: if canReadAllReviews() || canManageSchedule();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }

    // 封存後修改紀錄的待審申請（v1.64.0）：登入者可建立（申請人須為本人）；
    // 召集人／執行幹事／管理員審核；刪除限管理員。
    match /reviewEditRequests/{id} {
      allow read: if isAuthed()
        && (resource.data.get('requestedBy', '') == staffId()
          || canReadAllReviews() || canManageSchedule());
      allow create: if isAuthed()
        && request.resource.data.get('requestedBy', '') == staffId()
        && request.resource.data.get('status', '') == 'pending';
      allow update: if canManageSchedule();
      allow delete: if isAdmin();
    }

    // 尚未送出的逐件暫存：不進正式紀錄／分析；本人或管理員可編輯及刪除。
    match /reviewDrafts/{id} {
      allow read: if isAuthed() && (resource.data.get('createdBy', '') == staffId()
        || isAdmin()
        || get(/databases/$(database)/documents/reviewTasks/$(resource.data.get('taskId', ''))).data.get('reviewerId', '') == staffId());
      allow create: if isAuthed() && request.resource.data.get('createdBy', '') == staffId()
        && draftHasReservation(id, request.resource.data);
      allow update: if isAuthed()
        && (resource.data.get('createdBy', '') == staffId()
          || isAdmin()
          || get(/databases/$(database)/documents/reviewTasks/$(resource.data.get('taskId', ''))).data.get('reviewerId', '') == staffId())
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && draftHasReservation(id, request.resource.data);
      allow delete: if isAuthed() && (resource.data.get('createdBy', '') == staffId()
        || isAdmin()
        || get(/databases/$(database)/documents/reviewTasks/$(resource.data.get('taskId', ''))).data.get('reviewerId', '') == staffId());
    }

    // 同指標／區間／受審人員的唯一名額；create-only 可拒絕同一唯一鍵的競態建立。
    match /reviewReservations/{id} {
      allow get, list: if isAuthed() && (resource.data.get('ownerId', '') == staffId()
        || canReadAllReviews() || canManageSchedule());
      allow create: if isAuthed()
        && request.resource.data.get('uniqueKey', '') == id
        && request.resource.data.get('ownerId', '') == staffId()
        && reservationTargetMatches(id, request.resource.data);
      allow update: if isAuthed()
        && (resource.data.get('ownerId', '') == staffId()
          || canReadAllReviews() || canManageSchedule())
        && request.resource.data.get('uniqueKey', '') == id
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && request.resource.data.get('targetCollection', '') == resource.data.get('targetCollection', '')
        && request.resource.data.get('targetId', '') == resource.data.get('targetId', '')
        && reservationTargetMatches(id, request.resource.data);
      // v1.85.5：刪除補擁有者檢查（舊鎖須由本人或排程管理者清；
      // 封存修改核准會由執行幹事刪舊鎖）。未補之前任一登入者可刪他人
      // 唯一鍵鎖，刪完即可重複建立同一審查紀錄。
      allow delete: if isAuthed()
        && (isAdmin() || canManageSchedule()
          || resource.data.get('ownerId', '') == staffId());
    }

    // 解鎖申請（v1.15.0）：登入者可讀；申請人（requestedBy＝本人職編）可建立；
    // 執行幹事以上可審核更新；刪除限管理員
    match /unlockRequests/{id} {
      allow get, list: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.get('requestedBy', '') == staffId()
        && request.resource.data.get('status', '') == 'pending';
      allow update: if isGanShi();
      allow delete: if isAdmin();
    }

    // 業務資料：v1.85.5 收緊。schedules／reviews 為舊版集合，前端已無寫入點；
    // reportTemplates 前端亦無寫入點；三者寫入限排程管理者、刪除限管理員。
    // capa 寫入限管理員／排程管理者／督導（結案核准人）／案件負責人／撰寫人；
    // 院／區主管等職稱層級寫入（titleFlags，非 roles）規則無法判斷，見報告。
    match /schedules/{id} {
      allow read: if isAuthed();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if isAuthed();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }
    match /capa/{id} {
      allow read: if isAuthed() && canReadCapa(resource.data);
      allow create: if isAdmin() || canManageSchedule() || hasRole('督導')
        || request.resource.data.get('ownerId', '') == staffId()
        || request.resource.data.get('writerId', '') == staffId();
      allow update: if isAdmin() || canManageSchedule() || hasRole('督導')
        || resource.data.get('ownerId', '') == staffId()
        || resource.data.get('writerId', '') == staffId();
      allow delete: if isAdmin();
    }
    match /reportTemplates/{id} {
      allow read: if isAuthed();
      allow create, update: if canManageSchedule();
      allow delete: if isAdmin();
    }
  }
}

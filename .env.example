# Firebase Web SDK 公開設定（nurseboard-492316）。
# 填入專案設定 → 一般 → 你的應用程式 → Web 應用程式的設定值。
# 不要提交 .env.local、service account 或其他機密。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=nurseboard-492316
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 雙寫（Supabase 主／Firebase 備）。不設定或 VITE_DB_MODE 不是 dual ＝ 只用 Firebase（與先前相同）---
# VITE_DB_MODE=dual
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
